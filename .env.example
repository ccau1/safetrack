# SafeTrack Environment Configuration
# Copy this file to `.env` and fill in your actual values.

# --- Ports (Single Container Mode) ---
# WEB_PORT is the port the nginx frontend listens on INSIDE the container.
# To map it to a different host port, use docker run -p <host>:<container>
# or set WEB_PORT in compose and adjust the port mapping accordingly.
WEB_PORT=80
API_PORT=8080
NOTIFICATION_PORT=8081

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=safetrack
DB_USER=safetrack
DB_PASSWORD=safetrack

# --- Core Security ---
# Generate a strong random string for JWT signing
# Minimum 256 bits (32+ characters) recommended for HS256
JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- OAuth2 (Optional) ---
# Required only if you want Google or Azure AD SSO login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=common

# --- Email / SMTP ---
# For local dev, leave SMTP_HOST blank to log invite links to console instead of sending emails
# For production, use your email provider's SMTP settings (SendGrid, Gmail, AWS SES, etc.)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Web Base URL ---
# The public URL of your web frontend.
# Local dev: http://localhost:3010
# Production: https://app.yourdomain.com
WEB_BASE_URL=http://localhost:3010

# --- Invitation Links ---
# Optional override for invite email links. If unset, falls back to WEB_BASE_URL.
# INVITE_BASE_URL=http://localhost:3010

# --- OAuth2 Redirect ---
# Where the backend should redirect after OAuth2 login
OAUTH2_REDIRECT_URI=http://localhost:3010/auth/callback

# --- Cookie Settings ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Spring Profiles (Optional) ---
# e.g. SPRING_PROFILES_ACTIVE=oauth2 to enable OAuth2 login
# SPRING_PROFILES_ACTIVE=
