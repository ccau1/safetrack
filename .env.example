# SafeTrack Environment Configuration
# Copy this file to `.env` and fill in your actual values.

# --- Core Security ---
# Generate a strong random string for JWT signing
# Minimum 256 bits (32+ characters) recommended for HS256
JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- OAuth2 (Optional) ---
# Required only if you want Google or Azure AD SSO login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=common

# --- Email / SMTP ---
# For local dev, leave SMTP_HOST blank to log invite links to console instead of sending emails
# For production, use your email provider's SMTP settings (SendGrid, Gmail, AWS SES, etc.)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Invitation Links ---
# The public URL of your web frontend. Invite email links will point here.
# Local dev: http://localhost:3010
# Production: https://app.yourdomain.com
INVITE_BASE_URL=http://localhost:3010
