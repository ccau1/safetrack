# =============================================================================
# DEPLOY CONFIGURATION — Centralized Project Settings
# =============================================================================
# Copy this file to deploy/.env and fill in your values.
# =============================================================================

# ── Project Identity ───────────────────────────────────────────
# Used for remote paths, SSH key names, and SSL cert directories.
# Defaults to the repo folder name if left empty.
# PROJECT_NAME=safetrack

# ── Domains ────────────────────────────────────────────────────
DOMAIN_DEV=safetrack.dev.tribalorigin.com
DOMAIN_STAGING=safetrack.staging.tribalorigin.com
DOMAIN_PROD=safetrack.tribalorigin.com

# ── Server Connection ──────────────────────────────────────────
HOST=your-server-ip
USER=root
SSH_KEY=~/.ssh/safetrack-deploy

# ── Environment ────────────────────────────────────────────────
# Options: dev, staging, prod
ENV=staging

# ── Docker Image ───────────────────────────────────────────────
APP_IMAGE=ghcr.io/your-org/safetrack:staging

# Optional: GitHub Container Registry login for private images
GHCR_USER=
GHCR_TOKEN=

# ── Health Check ───────────────────────────────────────────────
HEALTH_URL=https://safetrack.staging.tribalorigin.com

# ── Let's Encrypt / Traefik ────────────────────────────────────
ACME_EMAIL=admin@example.com

# ── Terraform ──────────────────────────────────────────────────
# These are automatically exported as TF_VAR_* when running
# make tf-init / tf-plan / tf-apply / infra
HCLOUD_TOKEN=your-hetzner-cloud-api-token
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_PROXIED=true
